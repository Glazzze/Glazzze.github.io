---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---
<Layout><MetaPage slot="head" title="Publications" /><section class="placeholder"><p class="eyebrow">Coming later</p><h1>Publications</h1><p>This space will collect papers, preprints, and research outputs.</p></section></Layout>
<style>.placeholder{padding-block:var(--space-2xl)}.eyebrow{color:var(--accent);font-size:var(--step--1);text-transform:uppercase}.placeholder h1{margin:0 0 var(--space-s);font-size:var(--step-3)}.placeholder p:last-child{color:var(--muted-foreground);font-size:var(--step-1)}</style>
