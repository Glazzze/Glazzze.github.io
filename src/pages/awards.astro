---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const awards = (await getCollection("awards")).sort((a, b) => a.data.order - b.data.order)
---

<Layout>
  <MetaPage slot="head" title="Awards" />
  <header class="page-intro"><p class="eyebrow">Recognition</p><h1>Awards & honors</h1><p>A selection of scholarships, competition results, honors, and volunteer recognition.</p></header>
  <div class="award-list">
    {awards.map((award) => <article class="award-item"><div class="award-date">{award.data.date}</div><div><h2>{award.data.title}</h2><p>{award.data.organization}</p><span class={`category category-${award.data.category}`}>{award.data.category}</span></div></article>)}
  </div>
</Layout>

<style>
  .page-intro { padding-block: var(--space-2xl) var(--space-xl); border-bottom: 1px solid var(--border); }.eyebrow { margin: 0 0 var(--space-xs); color: var(--accent); font-size: var(--step--1); font-weight: var(--font-weight-medium); letter-spacing: .04em; text-transform: uppercase; }h1 { margin: 0; font-size: clamp(2.8rem, 9vw, 5rem); letter-spacing: -.05em; }.page-intro > p:last-child { max-width: 38rem; margin: var(--space-s) 0 0; color: var(--muted-foreground); font-size: var(--step-1); }
  .award-list { border-top: 0; }.award-item { display: grid; grid-template-columns: 9rem 1fr; gap: var(--space-l); padding-block: var(--space-l); border-bottom: 1px solid var(--border); }.award-date { color: var(--accent); font-family: var(--font-mono); font-size: var(--step--1); }.award-item h2 { margin: 0; font-size: var(--step-1); }.award-item p { margin: .35rem 0 var(--space-xs); color: var(--muted-foreground); }.category { padding: .2rem .55rem; border: 1px solid var(--border); border-radius: 99px; color: var(--muted-foreground); font-size: var(--step--1); text-transform: capitalize; }
  @media (width < 40rem) { .award-item { grid-template-columns: 1fr; gap: var(--space-xs); } }
</style>
