---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection, render } from "astro:content"

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
)
const rendered = await Promise.all(
  experience.map(async (item) => ({ item, Content: (await render(item)).Content })),
)
---

<Layout>
  <MetaPage slot="head" title="About" />
  <header class="page-intro">
    <p class="eyebrow">About me</p>
    <h1>Yajing Liu</h1>
    <p>I am a Computer Science and Technology undergraduate at Sun Yat-sen University. I am interested in AI for Science, AI agents, and the software systems that make research more reproducible.</p>
  </header>
  <section class="section-block" aria-labelledby="experience-heading">
    <p class="eyebrow">Background</p>
    <h2 id="experience-heading">Education & experience</h2>
    <div class="experience-list">
      {rendered.map(({ item, Content }) => <article class="experience-item"><div class="experience-meta"><span>{item.data.startDate} — {item.data.endDate || "Present"}</span><span>{item.data.type}</span></div><div><h3>{item.data.title}</h3><p class="organization">{item.data.organization}</p><div class="body"><Content /></div></div></article>)}
    </div>
  </section>
</Layout>

<style>
  .page-intro { padding-block: var(--space-2xl) var(--space-xl); border-bottom: 1px solid var(--border); }
  .eyebrow { margin: 0 0 var(--space-xs); color: var(--accent); font-size: var(--step--1); font-weight: var(--font-weight-medium); letter-spacing: .04em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.8rem, 9vw, 5rem); letter-spacing: -.05em; }.page-intro > p:last-child { max-width: 42rem; margin: var(--space-m) 0 0; color: var(--muted-foreground); font-size: var(--step-1); line-height: 1.6; }
  .section-block { display: flex; flex-direction: column; gap: var(--space-s); margin-block-start: var(--space-2xl); }.section-block h2 { margin: 0; font-size: var(--step-2); }
  .experience-list { border-top: 1px solid var(--border); }.experience-item { display: grid; grid-template-columns: 12rem 1fr; gap: var(--space-l); padding-block: var(--space-l); border-bottom: 1px solid var(--border); }.experience-meta { display: flex; flex-direction: column; gap: .35rem; color: var(--muted-foreground); font-family: var(--font-mono); font-size: var(--step--1); }.experience-meta span:last-child { color: var(--accent); font-family: var(--font-sans); text-transform: capitalize; }.experience-item h3 { margin: 0; font-size: var(--step-1); }.organization { margin: .35rem 0 0; color: var(--accent); }.body { margin-top: var(--space-s); color: var(--prose-foreground); line-height: 1.6; }
  @media (width < 40rem) { .experience-item { grid-template-columns: 1fr; gap: var(--space-xs); } }
</style>
