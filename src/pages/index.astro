---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"
import { getCollection } from "astro:content"

const projects = (await getCollection("projects", ({ data }) => data.featured)).slice(0, 3)
const research = (await getCollection("research", ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
)
const experience = (await getCollection("experience", ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
)
const posts = (await getPosts()).slice(0, 3)
---

<Layout>
  <MetaPage slot="head" title="Home" />
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Computer Science · Sun Yat-sen University</p>
      <h1>Hi, I'm <span>Yajing Liu</span>.</h1>
      <p class="lede">An undergraduate interested in AI for Science, AI agents, and the engineering foundations that make intelligent systems useful in the real world.</p>
      <div class="hero-actions"><a class="button button-primary" href="/blog">Read my notes <span aria-hidden="true">→</span></a><a class="button button-quiet" href="/authors/enscribe">More about me</a></div>
    </div>
  </section>

  <section class="section-block" aria-labelledby="research-heading"><div class="section-heading"><div><p class="section-kicker">What I care about</p><h2 id="research-heading">Research direction</h2></div><a class="section-link" href="/research">See all research →</a></div><div class="research-grid">
    {research.map((item, index) => <article class="research-card"><span class="card-number">{String(index + 1).padStart(2, "0")}</span><h3>{item.data.title}</h3><p>{item.data.summary}</p><div class="tag-list">{item.data.tags.map((tag) => <span>{tag}</span>)}</div></article>)}
  </div></section>

  <section class="section-block" aria-labelledby="projects-heading"><div class="section-heading"><div><p class="section-kicker">Selected work</p><h2 id="projects-heading">Projects</h2></div><a class="section-link" href="/projects">See all projects →</a></div><div class="project-grid">
    {projects.map((project) => <a class="project-card" href={project.data.link} target="_blank" rel="noopener noreferrer"><div class="project-topline"><span class="project-dot"></span><span>Open source</span></div><h3>{project.data.name}</h3><p>{project.data.description}</p><div class="tag-list">{project.data.tags?.map((tag) => <span>{tag}</span>)}</div></a>)}
  </div></section>

  <section class="section-block" aria-labelledby="notes-heading"><div class="section-heading"><div><p class="section-kicker">Writing and learning</p><h2 id="notes-heading">Latest notes</h2></div><a class="section-link" href="/blog">Browse all notes →</a></div><div class="notes-list">
    {posts.map((post) => <a class="note-row" href={`/blog/${post.id}`}><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="note-arrow" aria-hidden="true">↗</span></a>)}
  </div></section>

  <section class="section-block timeline-block" aria-labelledby="experience-heading"><div class="section-heading"><div><p class="section-kicker">Background</p><h2 id="experience-heading">Education & experience</h2></div><a class="section-link" href="/about">More about me →</a></div><div class="timeline">{experience.map((item) => <div class="timeline-item"><span class="timeline-year">{item.data.endDate || "Present"}</span><div><h3>{item.data.title}</h3><p>{item.data.organization} · {item.body?.trim() || ""}</p></div></div>)}</div></section>

  <section class="contact-banner" aria-labelledby="contact-heading"><div><p class="section-kicker">Let's connect</p><h2 id="contact-heading">Have a question or an interesting problem?</h2></div><p class="contact-email">liuyj363@mail2.sysu.edu.cn</p></section>
</Layout>

<style>
  .hero { display:flex; align-items:center; justify-content:space-between; gap:var(--space-xl); min-height:28rem; padding-block:var(--space-2xl) var(--space-xl); border-bottom:1px solid color-mix(in oklab,var(--accent) 20%,var(--border)); }
  .hero-copy { max-width:38rem; }.eyebrow,.section-kicker { margin:0 0 var(--space-xs); color:var(--accent); font-size:var(--step--1); font-weight:var(--font-weight-medium); letter-spacing:.04em; text-transform:uppercase; }
  h1 { max-width:12ch; margin:0; font-size:clamp(2.7rem,8vw,5.5rem); line-height:.98; letter-spacing:-.055em; } h1 span { color:var(--accent); }
  .lede { max-width:37rem; margin:var(--space-m) 0 0; color:var(--muted-foreground); font-size:var(--step-1); line-height:1.55; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:var(--space-xs); margin-top:var(--space-l); }.button { display:inline-flex; align-items:center; gap:.5rem; min-height:2.75rem; padding:.6rem 1rem; border-radius:var(--radius-md); text-decoration:none; font-size:var(--step--1); font-weight:var(--font-weight-medium); transition:transform .2s ease,background-color .2s ease,color .2s ease; }.button:hover { transform:translateY(-2px); }.button-primary { background:var(--accent); color:var(--accent-foreground); }.button-quiet { border:1px solid var(--border); color:var(--foreground); }
  .section-block { display:flex; flex-direction:column; gap:var(--space-s); margin-block-start:var(--space-2xl); }.section-heading { display:flex; align-items:end; justify-content:space-between; gap:var(--space-s); }.section-heading h2 { position:relative; width:fit-content; margin:0; padding-bottom:.35rem; font-size:var(--step-2); letter-spacing:-.035em; }.section-heading h2::after { content:""; position:absolute; bottom:0; left:0; width:2.5rem; height:3px; border-radius:99px; background:var(--accent); }.section-link { flex-shrink:0; color:var(--muted-foreground); font-size:var(--step--1); }
  .research-grid,.project-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-xs); }.research-card,.project-card { min-height:12rem; padding:var(--space-m); border:1px solid color-mix(in oklab,var(--accent) 20%,var(--border)); border-radius:var(--radius-lg); background:color-mix(in oklab,var(--accent-background) 78%,transparent); }.research-card { border-top:3px solid var(--accent); }.research-card h3,.project-card h3 { margin:var(--space-s) 0 var(--space-2xs); font-size:var(--step-1); }.research-card p,.project-card p { margin:0; color:var(--muted-foreground); line-height:1.55; }.card-number { color:var(--accent); font-family:var(--font-mono); font-size:var(--step--1); }
  .project-card { min-height:15rem; color:var(--foreground); text-decoration:none; transition:border-color .2s ease,transform .2s ease,background-color .2s ease; }.project-card:hover { border-color:var(--accent); background:color-mix(in oklab,var(--accent) 8%,var(--background)); transform:translateY(-3px); }.project-topline { display:flex; align-items:center; gap:.45rem; color:var(--muted-foreground); font-size:var(--step--1); }.project-dot { width:.55rem; height:.55rem; border-radius:50%; background:var(--accent); }.tag-list { display:flex; flex-wrap:wrap; gap:.35rem; margin-top:var(--space-s); }.tag-list span { padding:.2rem .55rem; border:1px solid var(--border); border-radius:99px; color:var(--muted-foreground); font-size:var(--step--1); }
  .notes-list { border-top:2px solid var(--accent); }.note-row { display:grid; grid-template-columns:7rem 1fr auto; align-items:center; gap:var(--space-s); padding:var(--space-s) .35rem; border-bottom:1px solid var(--border); color:inherit; text-decoration:none; transition:background-color .2s ease,padding .2s ease; }.note-row:hover { padding-inline:.7rem; background:color-mix(in oklab,var(--accent) 7%,transparent); }.note-row:hover h3,.note-row:hover .note-arrow { color:var(--accent); }.note-row time { color:var(--accent); font-size:var(--step--1); }.note-row h3 { margin:0; font-size:var(--step-0); transition:color .2s ease; }.note-row p { margin:.3rem 0 0; color:var(--muted-foreground); font-size:var(--step--1); }.note-arrow { color:var(--muted-foreground); font-size:var(--step-1); transition:color .2s ease; }
  .timeline { border-inline-start:2px solid var(--accent-soft,var(--border)); }.timeline-item { display:grid; grid-template-columns:5rem 1fr; gap:var(--space-s); padding:0 0 var(--space-m) var(--space-m); position:relative; }.timeline-item::before { content:""; position:absolute; left:-.4rem; top:.35rem; width:.65rem; height:.65rem; border:2px solid var(--accent); border-radius:50%; background:var(--background); }.timeline-year { color:var(--accent); font-family:var(--font-mono); font-size:var(--step--1); }.timeline-item h3 { margin:0 0 .25rem; font-size:var(--step-0); }.timeline-item p { margin:0; color:var(--muted-foreground); }
  .contact-banner { display:flex; align-items:center; justify-content:space-between; gap:var(--space-m); margin-block:var(--space-2xl) var(--space-xl); padding:var(--space-l); border:1px solid color-mix(in oklab,var(--accent) 35%,var(--border)); border-radius:var(--radius-lg); background:linear-gradient(110deg,color-mix(in oklab,var(--accent) 12%,var(--background)),color-mix(in oklab,var(--accent) 4%,var(--background))); }.contact-banner h2 { max-width:22ch; margin:0; font-size:var(--step-2); }
  .contact-email { margin:0; color:var(--accent); font-size:var(--step-0); font-weight:var(--font-weight-medium); overflow-wrap:anywhere; }
  @media (width < 48rem) { .hero { min-height:auto; align-items:flex-start; padding-block:var(--space-xl); }.research-grid,.project-grid { grid-template-columns:1fr; }.note-row { grid-template-columns:1fr auto; }.note-row time { grid-column:1 / -1; margin-bottom:calc(var(--space-2xs) * -1); }.contact-banner { align-items:flex-start; flex-direction:column; } }
</style>
