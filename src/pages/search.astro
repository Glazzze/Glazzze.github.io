---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage slot="head" title="Search" />
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <section class="search-page">
    <p class="eyebrow">Find something</p>
    <h1>Search</h1>
    <p class="intro">Search across notes, projects, research directions, and the rest of this site.</p>
    <div id="search" class="search-ui"></div>
  </section>
</Layout>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  new PagefindUI({
    element: "#search",
    showSubResults: true,
    showImages: false,
    translations: { placeholder: "Search notes, projects, and research…" },
  })
</script>

<style>
  .search-page { padding-block: var(--space-2xl); }
  .eyebrow { margin: 0 0 var(--space-xs); color: var(--accent); font-size: var(--step--1); font-weight: var(--font-weight-medium); letter-spacing: .04em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.8rem, 9vw, 5rem); letter-spacing: -.05em; }
  .intro { max-width: 36rem; margin: var(--space-s) 0 var(--space-l); color: var(--muted-foreground); font-size: var(--step-1); }
  .search-ui { max-width: 44rem; }
  :global(.pagefind-ui__search-input) { min-height: 3rem; border-color: var(--border) !important; border-radius: var(--radius-md) !important; background: var(--muted) !important; color: var(--foreground) !important; font: inherit !important; }
  :global(.pagefind-ui__result-link), :global(.pagefind-ui__result-title) { color: var(--accent) !important; }
  :global(.pagefind-ui__result-excerpt), :global(.pagefind-ui__result-nested) { color: var(--muted-foreground) !important; }
  :global(.pagefind-ui__result) { border-color: var(--border) !important; }
</style>
