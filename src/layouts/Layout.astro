---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/typography-math.css"
import "@/styles/callout.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"

import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import { SITE } from "@/consts"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs } = Astro.props
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <page-grid>
      <page-header id="page-header">
        <page-nav>
          <Sidebar crumbs={crumbs}
            ><slot name="actions" slot="actions" /></Sidebar
          >
        </page-nav>
        {Astro.slots.has("toc") && (
            <page-toc><slot name="toc" /></page-toc>
          )}
      </page-header>
      <page-content>
        <main><slot /></main>
        <page-footer><Footer /></page-footer>
      </page-content>
    </page-grid>
    <script is:inline>
      const header = document.getElementById("page-header")
      if (header) {
        const updateHeader = () => {
          header.toggleAttribute("data-scrolled", window.scrollY > 40)
        }
        updateHeader()
        window.addEventListener("scroll", updateHeader, { passive: true })
      }
    </script>
  </body>
</html>

<style>
  page-grid {
    position: relative;
    isolation: isolate;
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: 0;
  }

  page-header {
    display: block;
    position: sticky;
    top: 0;
    z-index: 10;
    min-width: 0;
    margin-inline: calc(-1 * var(--grid-gutter));
    padding-inline: var(--grid-gutter);
    background: transparent;
    border-block-end: 1px solid transparent;
    transition: background-color .25s ease, border-color .25s ease, box-shadow .25s ease, backdrop-filter .25s ease;

    &[data-scrolled] {
      background: color-mix(in oklab, var(--accent-background, var(--background)) 82%, transparent);
      border-block-end-color: color-mix(in oklab, var(--border) 75%, transparent);
      box-shadow: 0 0.5rem 1.5rem color-mix(in oklab, var(--accent) 10%, transparent);
      backdrop-filter: blur(18px) saturate(1.25);
    }
  }

  page-nav {
    display: block;
    min-width: 0;
    max-width: var(--grid-max-width);
    margin-inline: auto;
  }

  page-toc {
    display: block;
    min-width: 0;
    position: fixed;
    inset-block: calc(var(--page-offset-top) + 4rem) var(--page-offset-bottom);
    inset-inline-end: var(--grid-edge);
    width: calc(3 * var(--grid-column-width) + 2 * var(--grid-gutter));
  }

  page-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 52rem;
    margin-inline: auto;
    padding-block: var(--space-xl) var(--space-m);

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }

  }

  @media (width < 64rem) {
    page-toc { display: none; }
    page-content { inline-size: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    page-header { transition: none; }
  }
</style>
